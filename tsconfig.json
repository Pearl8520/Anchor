{
    "compilerOptions": {
        "module": "NodeNext",
        "target": "es2022",
        "rootDir": "./src",
        "outDir": "dist",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowJs": true,
        "resolveJsonModule": true,
        "moduleDetection": "force",
        "isolatedModules": true,
        "strict": true,
        "lib": ["es2022"]
      },
    "files": ["types/express.d.ts"],
    "include": ["src", "src/types"],
    "exclude": ["node_modules", "dist"]
}
